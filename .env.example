# Environment variables for Create React App (must use REACT_APP_ prefix)

# Base URL for your backend API. In mock mode this is not required and can be left blank.
# Example for same-origin dev proxy or when app and API are on same host/port:
REACT_APP_API_BASE_URL=

# OAuth settings (placeholder). Leave blank to enable mock auth in development.
# When integrating a real provider, set these to your IdP values.
REACT_APP_OAUTH_PROVIDER_URL=
REACT_APP_OAUTH_CLIENT_ID=
# Must match an allowed redirect URI configured in your OAuth provider
REACT_APP_OAUTH_CALLBACK_URL=http://localhost:3000/account

# Stripe publishable key (placeholder). If unset, UI stays functional and shows helpful messaging.
# Example test key format: pk_test_XXXXXXXXXXXXXXXXXXXXXXXX
REACT_APP_STRIPE_PUBLIC_KEY=

# Feature flags
# Mock API mode is enabled when this is 'true' OR when the variable is missing.
# In mock mode, API requests are intercepted client-side and served from in-memory handlers.
REACT_APP_FEATURE_MOCK_API=true
